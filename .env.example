# Nucho Solar Application - Environment Variables Template
# Copy this file to .env.local for local development

# Browser variables (VITE_ prefix): compiled into the bundle, so never secret.
VITE_APP_NAME=Nucho Solar
# Only used for the tap-to-call link shown if sending fails.
VITE_CONTACT_PHONE=254758330507
# Google Ads conversion label. Unset means no conversion event is sent.
VITE_ADS_CONVERSION_LABEL=

# Server-side, set in Vercel project settings, never prefix with VITE_.
# Read only by api/inquiry.ts. Do not put real values in this file.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# RESEND_API_KEY=
# RESEND_FROM=
# LEAD_EMAIL_TO=
# LEADS_WEBHOOK_URL=
# LEADS_WEBHOOK_SECRET=

# Optional: Analytics or tracking IDs
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_FB_PIXEL_ID=
